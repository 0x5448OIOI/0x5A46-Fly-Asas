function Section:Toggle(options)
    options = options or {}
    local key = options.Key
    local state
    if key and CFG[key] ~= nil then state = CFG[key] else state = options.Default or false end
    if key then CFG[key] = state end
    local window = self.Window
    local row = self:_row(26)
    local bell, keybind
    local labelRight = -48
    if options.Bell ~= false then labelRight = -74 end
    if options.Keybind ~= nil then labelRight = labelRight - 76 end
    if options.Name then
        new("TextLabel", {
            Size = UDim2.new(1, labelRight, 1, 0), BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium, Text = options.Name, TextSize = 12,
            TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
        })
    end
    local track = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = state and Theme.Accent or Theme.TrackOff,
        AutoButtonColor = false, Text = "", BorderSizePixel = 0, Parent = row,
    })
    corner(11, track)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, state and 23 or 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = state and Theme.KnobOn or Theme.KnobOff,
        BorderSizePixel = 0, Parent = track,
    })
    corner(9, knob)
    if options.Bell ~= false then bell = self:_bell(row, -52) end
    if options.Keybind ~= nil then
        local slot = new("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, (options.Bell ~= false) and -80 or -52, 0.5, 0),
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1, Parent = row,
        })
        keybind = self:_keybind(slot, options.Keybind, nil, options.BindId)
    end
    local function render()
        tween(track, { BackgroundColor3 = state and Theme.Accent or Theme.TrackOff }, SMOOTH)
        tween(knob, {
            Position = UDim2.new(0, state and 23 or 3, 0.5, 0),
            BackgroundColor3 = state and Theme.KnobOn or Theme.KnobOff,
        }, SMOOTH)
    end
    local function flip(silent)
        if self.Locked then return end
        state = not state
        if key then CFG[key] = state end
        render()
        if bell and bell.Get() then
            window:Notify({ Title = options.Name or self.Title,
                Text = state and "ativado" or "desativado", Duration = 2.5 })
        end
        if not silent and options.Callback then task.spawn(options.Callback, state) end
        if requestSave then requestSave() end
    end
    track.MouseButton1Click:Connect(function() flip(false) end)
    if keybind then
        table.insert(window.Binds, {
            Bind = function() return keybind.Get() end,
            Fire = function() flip(false) end,
        })
    end
    table.insert(Reg.accent, { obj = track, prop = "BackgroundColor3", only = function() return state end })
    table.insert(Reg.refresh, function()
        if key then state = CFG[key] and true or false end
        render()
    end)
    local api = {}
    function api:Set(value, silent)
        state = value and true or false
        if key then CFG[key] = state end
        render()
        if not silent and options.Callback then task.spawn(options.Callback, state) end
    end
    function api:Get() return state end
    self:_track({ Frame = row, Name = options.Name or self.Title, Api = api })
    return api
end

