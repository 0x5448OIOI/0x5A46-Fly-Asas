getKeyBtn.MouseButton1Click:Connect(function()
    local sucesso = false
    pcall(function()
        game:GetService("GuiService"):SetClipboard(GETKEY_URL)
        sucesso = true
    end)
    if not sucesso and type(setclipboard) == "function" then
        pcall(function() setclipboard(GETKEY_URL) sucesso = true end)
    end
    if sucesso then
        notify("Link copiado", "Cole no navegador para pegar sua chave.", 4)
    else
        notify("Link para chave", "Copie manualmente: " .. GETKEY_URL, 8)
    end
end)

local statusLbl = new("TextLabel", {
    Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -34),
    BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold,
    TextSize = 12, TextColor3 = Theme.Bad, Parent = lf,
})

do
    local dragging, startPos, startInput = false, nil, nil
    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startInput = true, lf.Position, input.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            lf.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                    startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local loggingIn = false
local function doLogin()
    if loggingIn then return end
    local key = string.gsub(keyBox.Text, "%s+", "")
    if key == "" then
        statusLbl.TextColor3 = Theme.Bad
        statusLbl.Text = "Digite uma chave"
        return
    end
    loggingIn = true
    statusLbl.TextColor3 = Theme.SubText
    statusLbl.Text = "Validando..."
    enterBtn.Text = "VALIDANDO..."
    tween(enterBtn, { BackgroundColor3 = Theme.Dim }, SMOOTH)
    local result = PUSL.validate(key)
    if result and result.success then
        AccessGranted = true
        statusLbl.TextColor3 = Theme.Good
        statusLbl.Text = "Acesso concedido"
        enterBtn.Text = "CARREGANDO..."
        tween(enterBtn, { BackgroundColor3 = Theme.Good }, SMOOTH)
        task.delay(0.55, function()
            tween(blur, { Size = 0 }, SMOOTH)
            tween(lf, { BackgroundTransparency = 1 }, SMOOTH)
            task.wait(0.35)
            pcall(function() blur:Destroy() end)
            pcall(function() loginGui:Destroy() end)
            Win.Main.Visible = true
            Win.Main.Size = UDim2.fromOffset(Win.Size.X, 48)
            tween(Win.Main, { Size = UDim2.fromOffset(Win.Size.X, Win.Size.Y) }, SMOOTH)
            local loaded = loadCfg()
            task.wait(0.3)
            notify("Midnight", loaded and "config carregada" or "painel pronto", 4)
        end)
    else
        statusLbl.TextColor3 = Theme.Bad
        statusLbl.Text = "Chave invalida ou expirada"
        enterBtn.Text = "ENTRAR"
        tween(enterBtn, { BackgroundColor3 = Theme.Accent }, SMOOTH)
        notify("Chave invalida", "Obtenha uma chave em: " .. GETKEY_URL, 6)
        local b = lf.Position
        tween(lf, { Position = b + UDim2.fromOffset(-8, 0) }, TweenInfo.new(0.04))
        task.wait(0.04)
        tween(lf, { Position = b + UDim2.fromOffset(8, 0) }, TweenInfo.new(0.04))
        task.wait(0.04)
        tween(lf, { Position = b }, TweenInfo.new(0.06))
    end
    loggingIn = false
end
enterBtn.MouseButton1Click:Connect(doLogin)
keyBox.FocusLost:Connect(function(enter) if enter then doLogin() end end)

