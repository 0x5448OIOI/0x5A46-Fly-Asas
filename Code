local visualOriginais = {}

local function limparVisual(tool)
    for _, v in ipairs(tool:GetChildren()) do
        if v.Name == "MN_Visual" then v:Destroy() end
    end
    local g = visualOriginais[tool]
    if g then
        local h = tool:FindFirstChild("Handle")
        if h then pcall(function() h.Transparency = g.transp end) end
    end
end

local function aplicarVisual(nome)
    local char = LP.Character
    if not char then F.visualInfo = "sem personagem" return false end
    local tool = char:FindFirstChild("EquippedFirework")
    if not tool then F.visualInfo = "equipe o foguete primeiro" return false end
    local fw = getFireWorks()
    local modelo = fw and fw:FindFirstChild(nome)
    if not modelo then F.visualInfo = "nao achei " .. tostring(nome) return false end
    local handle = tool:FindFirstChild("Handle")
    if not handle then F.visualInfo = "ferramenta sem Handle" return false end

    if visualOriginais[tool] == nil then
        visualOriginais[tool] = { transp = handle.Transparency }
    end
    limparVisual(tool)

    local ok = pcall(function()
        local novo = modelo:Clone()
        novo.Name = "MN_Visual"
        for _, v in ipairs(novo:GetDescendants()) do
            if v:IsA("BaseScript") then v:Destroy() end
        end
        local nh = novo:FindFirstChild("Handle")
        if not nh then novo:Destroy() error("modelo sem Handle") end
        handle.Transparency = 1
        local base = nh.CFrame
        for _, p in ipairs(novo:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Massless = true
                p.Anchored = false
                p.CFrame = handle.CFrame * base:ToObjectSpace(p.CFrame)
                local w = Instance.new("WeldConstraint")
                w.Part0 = handle
                w.Part1 = p
                w.Parent = p
            end
        end
        nh.CFrame = handle.CFrame
        novo.Parent = tool
    end)

    if ok then
        F.visualInfo = "aparencia: " .. nome
        return true
    end
    F.visualInfo = "falhou ao aplicar " .. nome
    return false
end

local function tirarVisual()
    local char = LP.Character
    local tool = char and char:FindFirstChild("EquippedFirework")
    if tool then limparVisual(tool) end
    table.clear(visualOriginais)
    F.visualInfo = "parado"
end

