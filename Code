local function getMapa()
    return workspace:FindFirstChild("GeneratedMap")
        or workspace:FindFirstChild("GenereatedMap")
        or workspace:FindFirstChild("Map")
end

local pastasCoins, ultimoScan = {}, 0
local function escanearSalas()
    pastasCoins = {}
    local mapa = getMapa()
    if not mapa then return 0 end
    for _, sala in ipairs(mapa:GetChildren()) do
        local coins = sala:FindFirstChild("Coins")
        if coins then pastasCoins[#pastasCoins + 1] = { pasta = coins, sala = sala } end
    end
    return #pastasCoins
end

local function posDe(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    local ok, pivot = pcall(function() return obj:GetPivot() end)
    if ok and pivot then return pivot.Position end
    return nil
end

local function contarCoins()
    local t = 0
    for _, e in ipairs(pastasCoins) do
        if e.pasta.Parent then t = t + #e.pasta:GetChildren() end
    end
    return t, #pastasCoins
end

local coinOriginal = {}
local function prepararCoin(part)
    if not part:IsA("BasePart") then return end
    if coinOriginal[part] == nil then
        coinOriginal[part] = { cf = part.CFrame, anc = part.Anchored, col = part.CanCollide }
    end
    part.Anchored = true
    part.CanCollide = false
end
local function restaurarCoins()
    local n = 0
    for part, o in pairs(coinOriginal) do
        if part and part.Parent then
            pcall(function()
                part.CFrame = o.cf
                part.Anchored = o.anc
                part.CanCollide = o.col
            end)
            n = n + 1
        end
    end
    table.clear(coinOriginal)
    return n
end
task.spawn(function()
    while true do
        task.wait(5)
        for part in pairs(coinOriginal) do
            if not part.Parent then coinOriginal[part] = nil end
        end
    end
end)

local magnetConn, magnetFrame = nil, 0
ligarMagnet = function()
    if magnetConn then return end
    escanearSalas()
    ultimoScan = tick()
    magnetConn = RunService.Heartbeat:Connect(function()
        if not CFG.magnetOn then return end
        local pos = getPosAlvo()
        if not pos then F.magnetInfo = "sem personagem" return end
        if not getMapa() then F.magnetInfo = "GeneratedMap nao encontrado" return end

        if tick() - ultimoScan > math.max(CFG.magnetRescan, 0.2) then
            ultimoScan = tick()
            escanearSalas()
        end

        -- balanco: sobe e desce a cada quadro pro toque repetir
        magnetFrame = magnetFrame + 1
        local off = (magnetFrame % 2 == 0) and CFG.magnetJitter or -CFG.magnetJitter
        local destino = CFrame.new(pos + Vector3.new(0, CFG.magnetAltura + off, 0))

        local movidos, salas = 0, 0
        for _, e in ipairs(pastasCoins) do
            if e.pasta.Parent then
                local dentro = true
                if CFG.magnetRaio > 0 then
                    local sp = posDe(e.sala)
                    dentro = sp and (sp - pos).Magnitude <= CFG.magnetRaio
                end
                if dentro then
                    local usou = false
                    for _, coin in ipairs(e.pasta:GetChildren()) do
                        if movidos >= CFG.magnetLote then break end
                        if coin:IsA("BasePart") then
                            prepararCoin(coin)
                            coin.CFrame = destino
                            movidos = movidos + 1
                            usou = true
                        elseif coin:IsA("Model") then
                            pcall(function()
                                for _, p in ipairs(coin:GetDescendants()) do
                                    if p:IsA("BasePart") then prepararCoin(p) end
                                end
                                coin:PivotTo(destino)
                            end)
                            movidos = movidos + 1
                            usou = true
                        end
                    end
                    if usou then salas = salas + 1 end
                end
            end
            if movidos >= CFG.magnetLote then break end
        end
        F.magnetInfo = ("puxando %d coin(s) de %d sala(s)"):format(movidos, salas)
    end)
end
local function desligarMagnet()
    if magnetConn then magnetConn:Disconnect() magnetConn = nil end
    restaurarCoins()
    F.magnetInfo = "parado"
end

