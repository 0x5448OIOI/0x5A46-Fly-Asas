local MOUSE_NAMES = {
    [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2",
    [Enum.UserInputType.MouseButton3] = "MB3",
}
local function bindLabel(bind)
    if not bind then return "None" end
    if bind.Mouse then return MOUSE_NAMES[bind.Mouse] or "Mouse" end
    if bind.Key then return bind.Key.Name end
    return "None"
end
local function bindMatches(bind, input)
    if not bind then return false end
    if bind.Mouse then return input.UserInputType == bind.Mouse end
    if bind.Key then return input.KeyCode == bind.Key end
    return false
end
local function bindToString(bind)
    if not bind then return "" end
    if bind.Mouse then return bind.Mouse.Name end
    if bind.Key then return bind.Key.Name end
    return ""
end
local function stringToBind(str)
    if type(str) ~= "string" or str == "" then return nil end
    for tipo in pairs(MOUSE_NAMES) do
        if tipo.Name == str then return { Mouse = tipo } end
    end
    local ok, code = pcall(function() return Enum.KeyCode[str] end)
    if ok and code then return { Key = code } end
    return nil
end

