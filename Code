        Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0, 18, 1, 0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = icon or "•",
        TextSize = 14, TextColor3 = Theme.SubText, Parent = button,
    })
    local textLabel = new("TextLabel", {
        Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -46, 1, 0),
