------------------------------------------------------------ FOGUETE INFINITO
-- O jogo guarda o combustivel em Character:GetAttribute("FireworkFuel")
-- e tem uma flag propria em LocalPlayer:GetAttribute("UnlimitedFuel").
-- O boostBegin do jogo so trava quando o fuel chega a zero, e essa
-- checagem roda no cliente: mantendo o valor cheio, ela nunca barra.
local fogueteConns = {}
local fogueteEnchendo = false
F.fogueteInfo = "parado"

local function fogueteMax(char)
    for _, nome in ipairs({ "MaxFireworkFuel", "FireworkFuelMax", "MaxFuel" }) do
        local v = char:GetAttribute(nome)
        if type(v) == "number" and v > 0 then return v end
    end
    local v = LP:GetAttribute("MaxFireworkFuel")
    if type(v) == "number" and v > 0 then return v end
    return CFG.fogueteValor
end

local function encherFoguete(char)
    if not CFG.foguete or fogueteEnchendo then return end
    char = char or LP.Character
    if not char then F.fogueteInfo = "sem personagem" return end
    fogueteEnchendo = true
    pcall(function()
        local alvo = math.max(fogueteMax(char), CFG.fogueteValor)
        local atual = char:GetAttribute("FireworkFuel")
        if type(atual) ~= "number" then
            F.fogueteInfo = "esse jogo nao usa FireworkFuel"
        else
            if atual < alvo then char:SetAttribute("FireworkFuel", alvo) end
            F.fogueteInfo = ("tanque em %d"):format(alvo)
        end
        if CFG.fogueteFlag and LP:GetAttribute("UnlimitedFuel") ~= true then
            LP:SetAttribute("UnlimitedFuel", true)
        end
    end)
    fogueteEnchendo = false
end

local function limparFogueteConns()
    for _, c in ipairs(fogueteConns) do pcall(function() c:Disconnect() end) end
    fogueteConns = {}
end

local function prenderFoguete(char)
    limparFogueteConns()
    if not char then return end
    encherFoguete(char)
    fogueteConns[#fogueteConns+1] = char:GetAttributeChangedSignal("FireworkFuel"):Connect(function()
        encherFoguete(char)
    end)
    fogueteConns[#fogueteConns+1] = char:GetAttributeChangedSignal("IsGliding"):Connect(function()
        encherFoguete(char)
    end)
end

ligarFoguete = function()
    prenderFoguete(LP.Character)
end
local function desligarFoguete()
    limparFogueteConns()
    F.fogueteInfo = "parado"
end

